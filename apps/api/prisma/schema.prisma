// path: apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum CourseStatus {
  passed
  failed
  retaken
  in_progress
  unknown
  absent_final
  banned_final
}

enum SectionType {
  LEC
  LAB
  OTHER
}

enum Role {
  USER
  ADMIN
}

enum SchoolType {
  university
  college
  highschool
  other
}

enum ExamPlanType {
  tentative
  official
}

enum ExamParseStatus {
  parsed
  partial
  failed
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)

  schoolType     SchoolType @default(university)
  universityName String?    // Tên trường (sinh viên tự nhập — hỗ trợ đa trường)
  birthDate      DateTime
  placeOfBirth   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings    UserSettings?
  imports     ImportSession[]

  transcripts          Transcript[]
  transcriptComponents TranscriptComponent[]
  timetables           Timetable[]
  sections             ClassSection[]
  evaluations          EvaluationDraft[]

  examNotices ExamNotice[]
  examRecords ExamRecord[]

  // ML
  mlGradeDatasets ML_GradeDataset[]
  mlPredictions   ML_Prediction[]

  // OmniScholar AI
  careerPathways  CareerPathway[]
  studyMaterials  StudyMaterial[]
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique

  theme               String   @default("system")
  language            String   @default("vi")
  density             String   @default("comfortable")

  emailAlerts         Boolean  @default(true)
  webPush             Boolean  @default(false)
  timetableReminders  Boolean  @default(true)
  deadlineReminders   Boolean  @default(true)
  gradeAlerts         Boolean  @default(true)
  weeklySummary       Boolean  @default(false)

  rememberDevice      Boolean  @default(true)
  analyticsOptIn      Boolean  @default(false)

  onboardingDismissed Boolean  @default(false)
  lastManualSyncAt    DateTime?
  lastExportAt        DateTime?

  avatarDataUrl       String?  @db.Text

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportSession {
  id             String       @id @default(cuid())
  userId         String
  adapterKey     String
  adapterVersion String
  sourcePage     String
  status         ImportStatus @default(SUCCESS)

  payloadHash    String

  recordCounts   Json?
  diffSummary    Json?

  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  createdAt      DateTime @default(now())

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  transcripts          Transcript[]
  transcriptComponents TranscriptComponent[]
  timetables           Timetable[]
  sections             ClassSection[]
  evaluations          EvaluationDraft[]
  examNotices          ExamNotice[]
  examRecords          ExamRecord[]

  @@unique([userId, adapterKey, adapterVersion, payloadHash], name: "uq_importsession_idempotent")
  @@index([userId, startedAt])
  @@index([adapterKey, adapterVersion])
}

model Transcript {
  id          String       @id @default(cuid())
  userId      String
  importId    String?

  courseCode  String
  classCode   String       @default("")
  courseName  String
  credits     Int

  score10     Float?
  letter      String?
  gpa4        Float?

  semester    String
  status      CourseStatus @default(unknown)

  componentsBreakdown Json?

  adapterKey     String
  adapterVersion String
  sourcePage     String
  lastSyncedAt   DateTime @default(now())

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  import      ImportSession? @relation(fields: [importId], references: [id], onDelete: SetNull)

  components  TranscriptComponent[]

  // ML — dataset rows derived from this transcript record
  mlGradeDatasets ML_GradeDataset[]

  @@unique([userId, courseCode, classCode, semester], name: "uq_transcript_natural")
  @@index([userId, semester])
  @@index([courseCode])
  @@index([userId, classCode])
}

model TranscriptComponent {
  id                 String   @id @default(cuid())
  userId             String
  importId           String?
  transcriptId       String

  semester           String
  courseCode         String
  classCode          String   @default("")
  courseName         String?

  componentKey       String?
  componentLabel     String
  score1             Float?
  score2             Float?
  scaleScore         Float?
  weightPercent      Float?
  contributionScore  Float?
  contributionMax    Float?
  displayOrder       Int      @default(0)

  rawText            String?  @db.Text

  adapterKey         String
  adapterVersion     String
  sourcePage         String
  lastSyncedAt       DateTime @default(now())

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  import             ImportSession?        @relation(fields: [importId], references: [id], onDelete: SetNull)
  transcript         Transcript            @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([userId, semester])
  @@index([userId, courseCode])
  @@index([userId, classCode])
  @@index([transcriptId])
  @@index([userId, transcriptId, displayOrder])
  @@unique([transcriptId, componentLabel, displayOrder], name: "uq_transcript_component_row")
}

model Timetable {
  id              String   @id @default(cuid())
  userId          String
  importId        String?

  semester        String
  weekLabel       String?
  weekStartDate   DateTime?
  weekEndDate     DateTime?
  occurrenceDate  DateTime

  courseCode      String
  courseName      String?

  dayOfWeek       Int
  startTime       String
  endTime         String
  room            String
  campus          String?

  weeksIncluded   String?
  weeksCanceled   String?

  adapterKey      String
  adapterVersion  String
  sourcePage      String
  lastSyncedAt    DateTime @default(now())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  import ImportSession? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([userId, occurrenceDate, courseCode, startTime, room], name: "uq_timetable_occurrence")
  @@index([userId, occurrenceDate])
  @@index([userId, semester])
}

model ClassSection {
  id             String      @id @default(cuid())
  userId         String
  importId       String?

  semester       String
  classCode      String
  courseCode     String
  credits        Int
  type           SectionType @default(OTHER)

  capacityStatus String
  note           String?

  scheduleSlots  Json?
  weeksIncluded  String?
  weeksCanceled  String?

  adapterKey     String
  adapterVersion String
  sourcePage     String
  lastSyncedAt   DateTime @default(now())

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  import         ImportSession? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([userId, semester, classCode], name: "uq_section_natural")
  @@index([userId, semester])
}

model EvaluationDraft {
  id             String @id @default(cuid())
  userId         String
  importId       String?

  semester       String
  lecturer       String
  courseCode     String
  courseName     String?

  answers        Json

  adapterKey     String
  adapterVersion String
  sourcePage     String
  lastSyncedAt   DateTime @default(now())

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  import         ImportSession? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([userId, semester])
}

model ExamNotice {
  id               String          @id @default(cuid())
  userId           String
  importId         String?

  planType         ExamPlanType    @default(official)
  parseStatus      ExamParseStatus @default(parsed)

  title            String
  rawTitle         String?
  sourceText       String?         @db.Text
  courseCodeHint   String?
  courseNameHint   String?

  detailUrl        String
  attachmentUrl    String?
  attachmentName   String?

  publishedAtRaw   String?
  publishedAt      DateTime?

  sourcePage       String
  adapterKey       String
  adapterVersion   String

  noticeHash       String
  isLatest         Boolean         @default(true)
  isSuperseded     Boolean         @default(false)
  supersededAt     DateTime?
  supersededReason String?

  detailText       String?         @db.Text
  parseError       String?         @db.Text
  lastSyncedAt     DateTime        @default(now())

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  import           ImportSession?  @relation(fields: [importId], references: [id], onDelete: SetNull)

  records          ExamRecord[]

  @@unique([userId, noticeHash], name: "uq_exam_notice_hash")
  @@unique([userId, detailUrl], name: "uq_exam_notice_detail")
  @@index([userId, planType, isLatest])
  @@index([userId, publishedAt])
  @@index([userId, title])
  @@index([userId, courseCodeHint])
}

model ExamRecord {
  id               String          @id @default(cuid())
  userId           String
  importId         String?
  noticeId         String?

  planType         ExamPlanType    @default(official)
  parseStatus      ExamParseStatus @default(parsed)

  noticeTitle      String
  publishedAtRaw   String?
  publishedAtDate  DateTime?

  detailUrl        String
  attachmentUrl    String?
  attachmentName   String?

  courseCode       String
  courseName       String?

  examDate         DateTime?
  examDateRaw      String?
  startTime        String?
  endTime          String?

  room             String?
  campus           String?
  examMetaRaw      String?         @db.Text

  studentId        String?
  studentName      String?
  classCourse      String?
  classStudent     String?
  birthDateRaw     String?
  birthDate        DateTime?
  note             String?

  recordHash       String
  rawRow           Json?

  isLatest         Boolean         @default(true)
  isSuperseded     Boolean         @default(false)
  supersededAt     DateTime?
  supersededReason String?

  sourcePage       String
  adapterKey       String
  adapterVersion   String
  parseError       String?         @db.Text
  lastSyncedAt     DateTime        @default(now())

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  import           ImportSession?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  notice           ExamNotice?     @relation(fields: [noticeId], references: [id], onDelete: SetNull)

  @@unique([userId, recordHash], name: "uq_exam_record_hash")
  @@index([userId, planType, examDate])
  @@index([userId, courseCode])
  @@index([userId, studentId])
  @@index([userId, studentName])
  @@index([userId, examDate])
  @@index([userId, isLatest, isSuperseded])
  @@index([noticeId])
}

// ══════════════════════════════════════════════════════════════════════
// ML — GRADE PREDICTION
// ══════════════════════════════════════════════════════════════════════

/// Trạng thái của một hàng dữ liệu trong tập huấn luyện
enum ML_RowStatus {
  pending   // Mới import, chưa được xác thực
  validated // Đã kiểm tra đủ features, sẵn sàng dùng để train
  excluded  // Bị loại (thiếu feature quan trọng, outlier, user yêu cầu)
}

/// Loại feature set — cho phép mở rộng sau này (ví dụ thêm BERT-based)
enum ML_FeatureSet {
  v1_basic   // midterm + attendance + cumGPA (MVP)
  v2_extended // thêm absences, hwScore, quizScore
}

// ─────────────────────────────────────────────────────────────────────
// Bảng chính: mỗi hàng = 1 lần học 1 môn của 1 sinh viên
// ─────────────────────────────────────────────────────────────────────
model ML_GradeDataset {
  id          String   @id @default(cuid())

  // ── Khoá ngoại đến User (sinh viên) ──────────────────────────────
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Khoá tự nhiên dùng để upsert / idempotent import ────────────
  studentId   String   // Mã sinh viên MyDTU (e.g. "21001234")
  courseCode  String   // Mã môn học    (e.g. "CSE101")
  semester    String   // Học kỳ        (e.g. "HK1_2024-2025")
  classCode   String   @default("") // Mã lớp học phần (phân biệt trường hợp retake)

  // ── Metadata môn học ──────────────────────────────────────────────
  courseName  String?
  credits     Int       // Số tín chỉ (feature quan trọng: môn nhiều TC → syllabus nặng hơn)
  sectionType SectionType @default(LEC) // LEC / LAB / OTHER

  // ── Features đầu vào (X) ─────────────────────────────────────────
  /// Điểm giữa kỳ / thành phần đánh giá giữa kỳ (thang 10, nullable nếu chưa có)
  midTermScore        Float?
  /// Điểm chuyên cần / thành phần điểm quá trình (thang 10)
  attendanceScore     Float?
  /// GPA tích lũy ở THỜI ĐIỂM TRƯỚC khi học môn này — snapshot lúc import
  cumulativeGPA       Float?
  /// Tổng số tín chỉ đã tích lũy (context về "độ dày" học vấn)
  creditEarned        Int?
  /// Số môn đã học cùng lúc trong học kỳ này (proxy cho workload)
  semesterCourseLoad  Int?

  // ── Feature mở rộng (v2 trở đi) ──────────────────────────────────
  /// Điểm bài tập / homework (thang 10, nếu có)
  homeworkScore       Float?
  /// Điểm quiz / kiểm tra thường xuyên (thang 10)
  quizScore           Float?
  /// Số buổi vắng mặt (nếu extension scrape được)
  absences            Int?

  // ── Nhãn mục tiêu (Y) — điểm cuối kỳ thực tế ────────────────────
  /// Điểm cuối kỳ thực tế (thang 10). NULL nếu môn chưa kết thúc → dùng để PREDICT
  finalScore          Float?
  /// Điểm GPA hệ 4 (chuyển đổi từ finalScore, lưu lại để tránh tính lại)
  finalGpa4           Float?
  /// Kết quả môn học lấy từ Transcript
  courseStatus        CourseStatus @default(unknown)

  // ── Phiên bản feature set đã dùng ────────────────────────────────
  featureSet          ML_FeatureSet @default(v1_basic)

  // ── Trạng thái hàng ──────────────────────────────────────────────
  rowStatus           ML_RowStatus  @default(pending)
  /// Lý do bị loại khỏi tập train (nếu rowStatus = excluded)
  excludeReason       String?

  // ── Audit ─────────────────────────────────────────────────────────
  /// ID của Transcript gốc — dùng để join lấy thêm thông tin khi cần
  transcriptId        String?
  transcript          Transcript?   @relation(fields: [transcriptId], references: [id], onDelete: SetNull)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // ── Predictions liên kết ─────────────────────────────────────────
  predictions         ML_Prediction[]

  // ── Constraints & Indexes ─────────────────────────────────────────
  /// Đảm bảo mỗi (sinh viên × môn × lớp × học kỳ) chỉ có 1 hàng dữ liệu
  @@unique([userId, courseCode, classCode, semester], name: "uq_ml_dataset_natural")

  /// Query nhanh theo sinh viên + học kỳ (UI "xem dự đoán học kỳ này")
  @@index([userId, semester])
  /// Query nhanh theo sinh viên + môn (lấy lịch sử học 1 môn)
  @@index([userId, courseCode])
  /// Lọc tập train: chỉ lấy hàng validated có finalScore
  @@index([rowStatus, finalScore])
  /// Lọc theo featureSet khi train model mới
  @@index([featureSet, rowStatus])
  /// Tìm theo studentId (khác userId — là mã SV in trên bảng điểm)
  @@index([studentId])

  @@map("ML_GradeDataset")
}

// ─────────────────────────────────────────────────────────────────────
// Registry phiên bản model đã train
// ─────────────────────────────────────────────────────────────────────
model ML_ModelVersion {
  id              String   @id @default(cuid())

  /// Tên mô hình (e.g. "grade_predictor_v1", "grade_predictor_v2_xgb")
  modelName       String
  /// Phiên bản ngữ nghĩa (e.g. "1.0.0", "2.1.3")
  version         String
  /// Thuật toán / framework (e.g. "linear_regression", "random_forest", "xgboost")
  algorithm       String
  /// Feature set được dùng để train
  featureSet      ML_FeatureSet

  // ── Metadata train ───────────────────────────────────────────────
  /// Số hàng dữ liệu được dùng để train
  trainSampleCount Int?
  /// Tỉ lệ train/test split (e.g. 0.8)
  trainTestSplit  Float?
  /// Ngày chạy train job
  trainedAt       DateTime?

  // ── Metrics đánh giá ─────────────────────────────────────────────
  /// Mean Absolute Error trên tập test
  metricMAE       Float?
  /// Root Mean Squared Error trên tập test
  metricRMSE      Float?
  /// R² Score (coefficient of determination)
  metricR2        Float?
  /// Accuracy trong khoảng ±0.5 điểm (business metric thực tế)
  metricAccuracy05 Float?

  /// Hyperparameters (JSON, ví dụ: {"n_estimators": 100, "max_depth": 5})
  hyperparams     Json?
  /// Feature importances (JSON), ví dụ: {"midTermScore": 0.55, "cumulativeGPA": 0.30}
  featureImportances Json?

  /// Model artifact đang được deploy hay không
  isActive        Boolean @default(false)
  /// Ghi chú người vận hành
  notes           String? @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  predictions     ML_Prediction[]
  featureImportanceRows ML_FeatureImportance[]

  @@unique([modelName, version], name: "uq_ml_model_version")
  @@index([modelName, isActive])
  @@index([featureSet, isActive])

  @@map("ML_ModelVersion")
}

// ─────────────────────────────────────────────────────────────────────
// Log từng lượt dự đoán (inference)
// ─────────────────────────────────────────────────────────────────────
model ML_Prediction {
  id              String   @id @default(cuid())

  // ── Liên kết ─────────────────────────────────────────────────────
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  datasetId       String
  dataset         ML_GradeDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  modelVersionId  String
  modelVersion    ML_ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  // ── Kết quả inference ────────────────────────────────────────────
  /// Điểm dự đoán (thang 10)
  predictedScore  Float
  /// Khoảng tin cậy dưới (ví dụ 95% CI)
  confidenceLow   Float?
  /// Khoảng tin cậy trên
  confidenceHigh  Float?
  /// Xác suất đỗ (score >= 5.0)
  passProbability Float?

  // ── Snapshot features tại thời điểm inference ────────────────────
  /// Lưu lại vector features đã dùng để tránh drift khi features thay đổi sau này
  featureSnapshot Json?

  // ── So sánh sau khi có kết quả thực ─────────────────────────────
  /// Điểm thực tế sau khi môn kết thúc (backfill)
  actualScore     Float?
  /// Sai lệch = |predictedScore - actualScore|
  absoluteError   Float?

  predictedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId, datasetId])
  @@index([userId, predictedAt])
  @@index([modelVersionId])
  // Tìm tất cả dự đoán chờ backfill (chưa có actualScore)
  @@index([actualScore])

  @@map("ML_Prediction")
}

// ─────────────────────────────────────────────────────────────────────
// Feature importance chi tiết theo từng model version
// (Explainability — giúp sinh viên hiểu tại sao điểm bị dự đoán thấp)
// ─────────────────────────────────────────────────────────────────────
model ML_FeatureImportance {
  id              String   @id @default(cuid())

  modelVersionId  String
  modelVersion    ML_ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)

  /// Tên feature (phải khớp với field trong ML_GradeDataset)
  featureName     String
  /// Mức độ quan trọng (0.0 → 1.0, tổng = 1.0)
  importance      Float
  /// Rank (1 = quan trọng nhất)
  rank            Int

  createdAt       DateTime @default(now())

  @@unique([modelVersionId, featureName], name: "uq_ml_feature_importance")
  @@index([modelVersionId, rank])

  @@map("ML_FeatureImportance")
}

// ══════════════════════════════════════════════════════════════════════

model Major {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseInfo {
  id              String   @id @default(cuid())
  courseCode      String   @unique
  name            String
  credits         Int
  difficultyScore Float?
  isKillerCourse  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Quan hệ môn học tiên quyết (Môn này coi môn khác là tiên quyết)
  prerequisites   CoursePrerequisite[] @relation("CourseToPrerequisites")
  
  // Quan hệ môn học tiên quyết (Môn này là tiên quyết cho môn khác)
  prerequisiteFor CoursePrerequisite[] @relation("PrerequisiteToCourses")
}

model CoursePrerequisite {
  id                   String     @id @default(cuid())
  
  courseId             String
  course               CourseInfo @relation("CourseToPrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  
  prerequisiteCourseId String
  prerequisiteCourse   CourseInfo @relation("PrerequisiteToCourses", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  createdAt            DateTime   @default(now())

  @@unique([courseId, prerequisiteCourseId])
}

// ══════════════════════════════════════════════════════════════════════
// OMNISCHOLAR AI — CAREER PATHWAYS & COGNITIVE LEARNING
// ══════════════════════════════════════════════════════════════════════

enum MaterialType {
  PDF
  LINK
}

/// Lộ trình nghề nghiệp do sinh viên khai báo mục tiêu
model CareerPathway {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Vị trí / nghề nghiệp mục tiêu (ví dụ: "Backend Engineer", "Data Scientist")
  targetJob      String

  /// Danh sách kỹ năng cần thiết, lưu dạng JSON array (ví dụ: ["Python", "SQL", "ML"])
  requiredSkills Json     @default("[]")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

/// Tài liệu học tập — PDF upload hoặc link ngoài
model StudyMaterial {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  type           MaterialType @default(LINK)

  /// URL nguồn — null nếu là file PDF upload trực tiếp
  sourceUrl      String?

  /// Nội dung văn bản đã bóc tách từ PDF / scrape từ URL (lưu Text dài)
  parsedContent  String?      @db.Text

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  flashcards     Flashcard[]

  @@index([userId])
  @@index([userId, type])
}

/// Flashcard sinh ra từ tài liệu học tập, hỗ trợ Spaced Repetition
model Flashcard {
  id           String        @id @default(cuid())
  materialId   String
  material     StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  question     String        @db.Text
  answer       String        @db.Text

  /// Lần cuối ôn tập
  lastReviewed DateTime?
  /// Ngày ôn tập tiếp theo (Spaced Repetition Algorithm)
  nextReview   DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([materialId])
  @@index([materialId, nextReview])
}